{
  "crons": [
    {
      "path": "/api/cron/instagram/refresh-tokens",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/instagram/daily-sync",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/cron/instagram/purge-metrics",
      "schedule": "0 5 * * *"
    },
    {
      "path": "/api/cron/instagram/generate-weekly-reports",
      "schedule": "0 2 * * 1"
    },
    {
      "path": "/api/cron/instagram/send-weekly-reports",
      "schedule": "0 11 * * 1"
    },
    {
      "path": "/api/cron/instagram/generate-monthly-reports",
      "schedule": "0 2 * * 1"
    },
    {
      "path": "/api/cron/instagram/send-monthly-reports",
      "schedule": "0 11 * * 1"
    }
  ]
}
