# Supabase (obrigatório)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_publishable_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Database — Prisma (obrigatório)
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:password@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres:password@db.YOUR_PROJECT_REF.supabase.co:5432/postgres

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Meta / Instagram (server-only — NUNCA NEXT_PUBLIC_)
# IMPORTANTE: use o Instagram App ID e Instagram App Secret de
# App Dashboard → Instagram → API setup with Instagram login → Business login settings.
# NÃO use o App ID / App Secret geral do topo do painel Facebook (causa "Invalid platform app").
INSTAGRAM_APP_ID=your_instagram_app_id
INSTAGRAM_APP_SECRET=your_instagram_app_secret
INSTAGRAM_REDIRECT_URI=http://localhost:3000/api/auth/instagram/callback
# Deve espelhar a Embed URL do App Dashboard (Business login settings), na mesma ordem:
INSTAGRAM_OAUTH_SCOPES=instagram_business_basic,instagram_business_manage_messages,instagram_business_manage_comments,instagram_business_content_publish,instagram_business_manage_insights
INSTAGRAM_TOKEN_ENCRYPTION_KEY=your_32_bytes_base64_key
INSTAGRAM_OAUTH_STATE_SECRET=your_random_hmac_secret

# Cron
CRON_SECRET=your_cron_secret

# Instagram Analytics Sync (opcional)
INSTAGRAM_SYNC_BATCH_SIZE=25
INSTAGRAM_SYNC_MAX_RETRIES=3
INSTAGRAM_METRIC_RETENTION_DAYS=90

# Connex CRM — envio de relatórios (obrigatório para os crons de relatórios)
CONNEX_CRM_URL=https://crm.connexapp.com.br
CONNEX_INSIGHTS_INGEST_SECRET=your_shared_ingest_secret

# Supabase Auth (configurar manualmente no dashboard):
# - Desabilitar "Enable email signup"
# - Redirect URLs: http://localhost:3000/auth/callback, http://localhost:3000/redefinir-senha
# - Site URL: http://localhost:3000
